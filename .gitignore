# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Testing
.pytest_cache/
mock_test/

# Claude Code
.claude/
.idea/
# Temp
tmp/
CLAUDE.md
*.txt
# ...but the shipped prompt tree is runtime data, not scratch text.
!/spectragent/prompts/**/*.txt
.env
# macOS
.DS_Store

# Demo / debug scripts (root-level only)
/demo_*.py
/test_*.py
/debug_*.py
/demo.py
/browser_api.txt
/issue.md

# Build / runtime artefacts
*.egg-info/
# setuptools reuses build/lib without pruning — a stale tree silently ships
# deleted modules into the wheel.
/build/
/test_path/
/traces/

# conscribe codegen output (regenerate via spectragent.scripts.generate_all)
*.pyi
# Contents, not the directory: git does not descend into an excluded
# directory, so a negation for a file inside one never fires.
/spectragent/generated/*
# ...except the fingerprint. The generated config is the surface users write
# YAML against, so a `__wiring__` change is a user-visible API change — and by
# the same argument that made ``docs/`` tracked below, it cannot be reviewed
# alongside the change that causes it while it lives outside the repository.
# Tracking ``_composed.py`` itself would put a 68k derived file in the path of
# every parallel branch; the 575-byte fingerprint carries the same signal as a
# one-line diff and merges by regenerating. ``test_generated_in_sync`` compares
# it against the live registries, because a stale ``_composed.py`` is
# internally consistent and passes the entire suite.
!/spectragent/generated/.fingerprint.json

# ``docs/`` is tracked. ``architecture_design.md`` is this repo's source of
# truth (AGENTS.md §0.1) — a source of truth that is not in the repository
# cannot be reviewed alongside the change that follows it, and rule 1 was
# effectively dangling for as long as this said ``/docs/``.
# Local-only data sets
/benchmarks/
# Benchmark data is fetched, not tracked, and no longer ships in the wheel.
# Loaders find it via `data_dir:` or $SPECTRAGENT_BENCHMARK_DATA — see
# configs/README.md. (Inert while the current copies are still in the index:
# git ignores nothing it already tracks.)
/spectragent/benchmark_data/

# Vendored upstream sources kept locally for inspection only
/ref/
/test_reality

# Icon / logo source art and the raster check that renders it. Build inputs
# for the published icons, not something the package reads at runtime.
/assets/
