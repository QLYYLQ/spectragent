<?xml version="1.0" encoding="utf-8"?>
<!-- No launcher activity: the app adds no icon to the launcher, so a screenshot
     of the home screen or the app drawer is the same with or without it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- launcher_apps lists every app the home screen lists, with its label: from API 30 an
         app sees only the packages its queries name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".DeviceService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Exported so that `adb shell content call` reaches it; it serves the
             shell and root users only (BootstrapProvider checks the caller). -->
        <provider
            android:name=".BootstrapProvider"
            android:authorities="org.spectragent.device.bootstrap"
            android:exported="true" />
    </application>
</manifest>
