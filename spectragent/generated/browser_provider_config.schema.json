{
  "$defs": {
    "AgentbayBrowser_ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AgentBay API key (env: AGENTBAY_API_KEY)",
          "title": "Api Key"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AgentBay RPC endpoint (env: AGENTBAY_ENDPOINT)",
          "title": "Endpoint"
        },
        "stealth": {
          "default": false,
          "description": "Enable stealth browsing mode",
          "title": "Stealth",
          "type": "boolean"
        },
        "enable_recording": {
          "default": true,
          "description": "Enable browser session recording",
          "title": "Enable Recording",
          "type": "boolean"
        },
        "proxy_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Managed proxy country code (e.g. 'US')",
          "title": "Proxy Country"
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Context ID for persistence across sessions",
          "title": "Context Id"
        },
        "provider_id": {
          "const": "agentbay",
          "default": "agentbay",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "title": "AgentbayBrowser_ProviderConfig",
      "type": "object"
    },
