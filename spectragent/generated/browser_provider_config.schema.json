          "title": "Base Url"
        },
        "timeout_minutes": {
          "default": 60,
          "description": "Session timeout in minutes (5-1440)",
          "title": "Timeout Minutes",
          "type": "integer"
        },
        "solve_captcha": {
          "default": false,
          "description": "Enable automatic CAPTCHA solving",
          "title": "Solve Captcha",
          "type": "boolean"
        },
        "adblock": {
          "default": false,
          "description": "Enable ad / tracker blocking",
          "title": "Adblock",
          "type": "boolean"
        },
        "proxy_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Managed proxy country code (e.g. 'US')",
          "title": "Proxy Country"
        },
        "provider_id": {
          "const": "skyvern",
          "default": "skyvern",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "title": "SkyvernBrowser_ProviderConfig",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "agentbay": "#/$defs/AgentbayBrowser_ProviderConfig",
      "airtop": "#/$defs/AirtopBrowser_ProviderConfig",
      "browser_use": "#/$defs/BrowserUseBrowser_ProviderConfig",
      "hyperbrowser": "#/$defs/HyperbrowserBrowser_ProviderConfig",
      "lexmount": "#/$defs/LexmountBrowser_ProviderConfig",
      "local_chrome": "#/$defs/LocalChromeBrowser_ProviderConfig",
      "skyvern": "#/$defs/SkyvernBrowser_ProviderConfig"
    },
    "propertyName": "provider_id"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AgentbayBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/AirtopBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/BrowserUseBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/HyperbrowserBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/LexmountBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/LocalChromeBrowser_ProviderConfig"
    },
    {
      "$ref": "#/$defs/SkyvernBrowser_ProviderConfig"
    }
  ],
  "x-discriminator": "provider_id"
}
