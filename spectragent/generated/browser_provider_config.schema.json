          "title": "Solve Captchas",
          "type": "boolean"
        },
        "adblock": {
          "default": false,
          "description": "Enable ad / tracker blocking",
          "title": "Adblock",
          "type": "boolean"
        },
        "enable_recording": {
          "default": false,
          "description": "Enable web session recording",
          "title": "Enable Recording",
          "type": "boolean"
        },
        "proxy_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
