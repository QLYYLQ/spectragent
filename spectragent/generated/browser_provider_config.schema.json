          "title": "Screen Height"
        },
        "provider_id": {
          "const": "browser_use",
          "default": "browser_use",
          "title": "Provider Id",
          "type": "string"
        }
      },
      "title": "BrowserUseBrowser_ProviderConfig",
      "type": "object"
    },
    "HyperbrowserBrowser_ProviderConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hyperbrowser API key (env: HYPERBROWSER_API_KEY)",
          "title": "Api Key"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API base URL override",
          "title": "Base Url"
        },
        "stealth": {
          "default": true,
